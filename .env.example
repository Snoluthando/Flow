# Supabase — from your project's Settings > API page
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of this deployment (used in emails and the public invoice link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain you've verified in Resend
RESEND_FROM_EMAIL=invoices@yourdomain.com
